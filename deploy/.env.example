# ─────────── 배포 이미지 ───────────
# app 컨테이너가 실행할 ECR 이미지. GitHub Actions가 배포할 때마다 이 값을 갱신한다.
# 태그는 커밋 SHA를 쓴다(롤백 시 이전 SHA로 되돌리기 위함).
APP_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/whynago-repo:latest

# ─────────── Spring ───────────
# application-prod.yml 을 활성화한다.
SPRING_PROFILES_ACTIVE=prod

# ─────────── MySQL ───────────
MYSQL_DATABASE=whynago
MYSQL_ROOT_PASSWORD=반드시-변경-root-비밀번호

# 아래 두 값은 app의 DB 접속 계정이자 db 컨테이너가 생성할 계정이다.
# (docker-compose.yml 에서 MYSQL_USER/MYSQL_PASSWORD 로 재사용된다)
DB_USERNAME=whynago
DB_PASSWORD=반드시-변경-앱-비밀번호

DB_URL=jdbc:mysql://db:3306/whynago?characterEncoding=UTF-8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

# ─────────── JWT ───────────
JWT_SECRET=

# ─────────── Gemini (Spring AI) ───────────
API_KEY=

# ─────────── Grafana Cloud ───────────
GCLOUD_HOSTED_METRICS_ID=
GCLOUD_HOSTED_METRICS_URL=
GCLOUD_HOSTED_LOGS_ID=
GCLOUD_HOSTED_LOGS_URL=
GCLOUD_FM_URL=
GCLOUD_FM_POLL_FREQUENCY=60s
GCLOUD_FM_HOSTED_ID=
GCLOUD_RW_API_KEY=
