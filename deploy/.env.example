# ─────────── Spring ───────────
# application-prod.yml 을 활성화한다.
SPRING_PROFILES_ACTIVE=prod

# ─────────── MySQL ───────────
MYSQL_DATABASE=whynago
MYSQL_ROOT_PASSWORD=반드시-변경-root-비밀번호

# 아래 두 값은 app의 DB 접속 계정이자 db 컨테이너가 생성할 계정이다.
# (docker-compose.yml 에서 MYSQL_USER/MYSQL_PASSWORD 로 재사용된다)
DB_USERNAME=whynago
DB_PASSWORD=반드시-변경-앱-비밀번호

DB_URL=jdbc:mysql://db:3306/whynago?characterEncoding=UTF-8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

# ─────────── JWT ───────────
JWT_SECRET=

# ─────────── Gemini (Spring AI) ───────────
API_KEY=
